SCENEROOT_PORT=4174
SCENEROOT_DATA=/var/lib/sceneroot
SCENEROOT_MEDIA=/mnt/media,/media/usb
SCENEROOT_WATCH=true
SCENEROOT_MIN_FREE_GB=50
# Facultatif : socket/pipe IPC de mpv (défaut : /tmp/sceneroot-mpv.sock sous Linux)
# SCENEROOT_MPV_IPC=/tmp/sceneroot-mpv.sock
# Facultatif : origines CORS autorisées en plus de localhost (séparées par des virgules).
# Par défaut, seules les origines localhost et les requêtes same-origin sont acceptées.
SCENEROOT_ALLOWED_ORIGINS=
# Facultatif : token requis pour piloter le lecteur, les téléchargements, les
# scans et le CEC depuis un appareil DISTANT. Le kiosque local (loopback) n'en a
# pas besoin. Sans token défini, l'administration distante est refusée.
# Par défaut, le réseau local privé (LAN) est de confiance : les réglages
# fonctionnent sans jeton depuis un mobile/ordinateur du domicile. Le jeton
# n'est requis que pour un accès hors du domicile (WAN) ou en mode strict.
# Mode strict (jeton requis même sur le LAN) : SCENEROOT_REQUIRE_TOKEN=1
# SCENEROOT_REQUIRE_TOKEN=
# Sans SCENEROOT_ADMIN_TOKEN, un jeton peut être généré depuis l'interface locale.
# En-tête à fournir : "X-SceneRoot-Token: <token>" ou "Authorization: Bearer <token>".
# ATTENTION : n'exposez pas l'API derrière un reverse proxy sur le même hôte sans
# précaution. Le contrôle d'accès distant se base sur l'adresse IP de connexion ;
# derrière un proxy local, toutes les requêtes paraissent venir de 127.0.0.1 et
# seraient traitées comme locales. Servez l'interface en direct (mode kiosque),
# ou placez l'authentification au niveau du proxy.
SCENEROOT_ADMIN_TOKEN=
# Facultatif : utilise TMDB pour les catalogues films/séries. Sans clé,
# SceneRoot utilise Wikipédia (films) et TVmaze (séries).
TMDB_API_KEY=
# Facultatif : instance Transmission locale pour les contenus autorisés.
# SceneRoot force le dossier de téléchargement dans <première racine SCENEROOT_MEDIA>/downloads
# (indexé automatiquement) et limite à 3 téléchargements simultanés.
# La lecture progressive (démarrer avant la fin) active le téléchargement séquentiel,
# disponible avec Transmission >= 4.1 ; sur une version antérieure, la lecture démarre
# une fois le fichier suffisamment/entièrement téléchargé.
TRANSMISSION_RPC_URL=http://127.0.0.1:9091/transmission/rpc
TRANSMISSION_RPC_AUTH=sceneroot:change-me
# Preset Torznab C411 (facultatif, pour les contenus autorisés).
# L'URL par défaut est indicative ; renseignez l'URL Torznab réelle de votre
# indexeur (ex. via Jackett/Prowlarr) et, si besoin, les catégories.
C411_API_KEY=
# C411_TORZNAB_URL=http://127.0.0.1:9117/api/v2.0/indexers/c411/results/torznab/
# C411_CATEGORIES=2000,5000
# Autres sources : [{"id":"legal","name":"Source légale","url":"https://example.org/api","apiKey":"...","categories":"2000,5000"}]
SCENEROOT_TORZNAB_SOURCES=[]
