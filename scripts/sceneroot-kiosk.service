[Unit]
Description=SceneRoot direct TV kiosk (Cage/Wayland)
After=systemd-user-sessions.service network-online.target sceneroot.service sceneroot-cec.service seatd.service
Wants=network-online.target sceneroot.service sceneroot-cec.service seatd.service
Conflicts=getty@tty1.service display-manager.service
OnFailure=sceneroot-kiosk-fallback.service

[Service]
Type=simple
User=@SCENEROOT_USER@
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
RuntimeDirectory=sceneroot-kiosk
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/sceneroot-kiosk
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_SEAT=seat0
Environment=LIBSEAT_BACKEND=seatd
EnvironmentFile=-/etc/sceneroot.env
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/bin/cage -- /opt/sceneroot/scripts/kiosk.sh
Restart=no

[Install]
WantedBy=multi-user.target
